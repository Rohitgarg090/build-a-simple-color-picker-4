# ============================================================
# 🎨 ColorPicker — Environment Variables
# ============================================================
# Copy this file to:
#   frontend/.env.local   (for Next.js)
#   backend/.env          (for Express)
# Then fill in all required values.
# ============================================================


# ------------------------------------------------------------
# 🔷 SUPABASE — Required for both frontend and backend
# ------------------------------------------------------------

# Your Supabase project URL
# Found at: Supabase Dashboard → Settings → API → Project URL
co
co

# Supabase anon/public key (safe to expose in frontend)
# Found at: Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (KEEP SECRET — backend only, never expose to frontend)
# Found at: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ------------------------------------------------------------
# 🟢 EXPRESS BACKEND
# ------------------------------------------------------------

# Port the Express server runs on
BACKEND_PORT=4000

# Node environment
NODE_ENV=development

# Secret for signing any server-side tokens (if needed)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-secret-here


# ------------------------------------------------------------
# 🔵 NEXT.JS FRONTEND
# ------------------------------------------------------------

# The base URL of the Express backend
# In development: http://localhost:4000
# In production: your deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# App public URL (used for metadata, OG tags, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ------------------------------------------------------------
# 🛡️ CORS (backend)
# ------------------------------------------------------------

# Allowed origins for CORS (comma-separated if multiple)
# In development: http://localhost:3000
# In production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
